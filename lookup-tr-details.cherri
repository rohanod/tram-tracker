#include 'actions/web'
#include 'actions/text'

#define color blue
#define glyph tram

#question apiToken "What is the Vehicle Tracker API token?" ""

action 'ask' promptWholeNumber(text prompt: 'WFAskActionPrompt'): number {
    "WFInputType": "Number",
    "WFAskActionAllowsDecimalNumbers": false,
    "WFAskActionAllowsNegativeNumbers": false
}

const shortcutToken = text(apiToken)
const apiURL = "https://rapid-signal-1f4a040df6.lakebed.app/api/shortcut/lookup"

@vehicleNumber = promptWholeNumber("Vehicle number")
@vehicleNumberRemainder = @vehicleNumber % 1

repeat attempt for 10 {
    if @vehicleNumber < 100 || @vehicleNumber > 9999 || @vehicleNumberRemainder != 0 {
        alert("Vehicle number must be a 3 or 4 digit whole number.", "Invalid vehicle number")
        @vehicleNumber = promptWholeNumber("Vehicle number")
        @vehicleNumberRemainder = @vehicleNumber % 1
    }
}

if @vehicleNumber < 100 || @vehicleNumber > 9999 || @vehicleNumberRemainder != 0 {
    alert("Vehicle number must be a 3 or 4 digit whole number.", "Invalid vehicle number")
    stop()
}

const response = jsonRequest(apiURL, "POST", {
    "vehicleNumber": "{@vehicleNumber}"
}, {
    "Authorization": "Bearer {shortcutToken}",
    "Accept": "application/json"
})

const historyEntries = getValue(response, "entries")
const historyCount = count(historyEntries)
if historyCount == 0 {
    show("No saved observations for vehicle {@vehicleNumber}.")
    stop()
}

const rawSummary = getValue(response, "summary")
const summary = getText(rawSummary)
const selectedEntry = chooseFromList(historyEntries, "Vehicle {@vehicleNumber} — {summary}")
@selectedLabel = getText(selectedEntry)
const rawHistoryDetails = getValue(response, "details")
const historyDetails = getDictionary(rawHistoryDetails)
const rawSelectedDetails = getValue(historyDetails, @selectedLabel)
const selectedDetails = getText(rawSelectedDetails)
show("{selectedDetails}")
